# copy to .env for local work & server reads real env vars 
# on a real host set these in service file/settings; _NEVER_ commit the real values

# port listens; the host stays on loopback when a tunnel or proxy sits in front

PORT=3000
HOST=127.0.0.1

# prod turns on secure cookies & refuses to start w/ anything missing below

NODE_ENV=

# the pg's origin; links in mail & the origin check use it

DOMAIN=http://localhost:3000

# the API's host when differs from pg, e.g. https://api.example.com

API_ORIGIN=

# sqlite file orig; def to spore.db next to the code

DB_PATH=

# mail: console printsthe terminal; resend sends for real

MAIL_TRANSPORT=console
RESEND_API_KEY=
FROM_EMAIL=nomatter@example.com

# open, allowlist or closed. has to be set on purpose in production

SIGNUP_MODE=open

# extra addrs allowed to sign up in allowlist mode; comma separated

SIGNUP_ALLOWLIST=

# stewards, comma separated; may always signup & can moderate

ADMIN_EMAILS=

# chars per matter

MAX_POST_CHARS=1000

# scrypt cost as log2(N); 17 is owasp's floor uses 128 MiB/hash

PASSWORD_COST=17

# how far to trust X-Forwarded-For; loopback suits tunnel on same machine

TRUST_PROXY=loopback

# sign in w/ provider: each switches on when keys are set

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# build time for the page: API origin baked into bundle (empty when share a host)

API_BASE=
